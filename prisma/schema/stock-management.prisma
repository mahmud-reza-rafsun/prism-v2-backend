model StockManagement {
  id                   String       @id @default(uuid())
  region               String?
  area                 String?
  distributionHouse    String?
  skuOpening           Int          @default(0)
  shipment             Int          @default(0)
  igt                  Int          @default(0)
  stt                  Int          @default(0)
  stolen               Int          @default(0)
  warehouseQc          Int          @default(0)
  closing              Int          @default(0)
  scr                  Int          @default(0)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  businessDateId       String
  stockManagementSkuId String
  businessDate         BusinessDate @relation(fields: [businessDateId], references: [id])

  @@map("stock_management")
}
