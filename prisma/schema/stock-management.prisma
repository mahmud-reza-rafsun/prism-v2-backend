model StockManagement {
  id         String   @id @default(uuid())
  skuOpening Int      @default(0)
  shipment   Int      @default(0)
  igt        Int      @default(0)
  stt        Int      @default(0)
  closing    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stockManagementSkuId String
  stockManagementSku   StockManagementSku @relation(fields: [stockManagementSkuId], references: [id], onDelete: Restrict)

  businessDateId String
  businessDate   BusinessDate @relation(fields: [businessDateId], references: [id], onDelete: Restrict)

  @@index([stockManagementSkuId])
  @@index([businessDateId])
  @@map("stock_management")
}
