model RouteWiseMemo {
  id             String       @id @default(uuid())
  region         String
  area           String
  territory      String
  house          String
  point          String
  route          Int          @default(0)
  target         Int          @default(0)
  successfulCall Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  businessDateId String
  sttSkuId       String
  businessDate   BusinessDate @relation(fields: [businessDateId], references: [id])

  @@map("route_wise_memo")
}
