model Area {
    id String @id @default(uuid())

    name String
    code String? @unique

    regionId   String
    regionCode String
    regionName String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    region Region @relation(fields: [regionId], references: [id])

    territories Territory[]

    @@unique([name, regionId])
    @@map("area")
}
