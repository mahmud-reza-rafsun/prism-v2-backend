model SttSku {
  id                   String                 @id @default(uuid())
  name                 String                 @unique
  code                 String?                @unique
  packSize             String?
  brandId              String
  brand                Brand                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  familyId             String
  family               Family                 @relation(fields: [familyId], references: [id], onDelete: Restrict)
  segmentId            String
  segment              Segment                @relation(fields: [segmentId], references: [id], onDelete: Restrict)
  retailerPrice        RetailerPrice?         @relation(fields: [retailerPriceId], references: [id], onDelete: Restrict)
  retailerPriceId      String?
  isActive             SttSkuStatus           @default(ACTIVE)
  ownPointDistribution OwnPointDistribution[]
  routeWiseMemo        RouteWiseMemo[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  routeWiseStts        RouteWiseStt[]
  byOutletStts         ByOutletStt[]

  @@index([segmentId, familyId, brandId, retailerPriceId])
  @@map("stt_sku")
}
