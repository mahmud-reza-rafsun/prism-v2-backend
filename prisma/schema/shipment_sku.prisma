model ShipmentSku {
  id        String            @id @default(uuid())
  name      String            @unique
  code      String?           @unique
  packSize  String?
  isActive  ShipmentSkuStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  shipmentOrders     ShipmentOrder[]
  distributorPrice   DistributorPrice? @relation(fields: [distributorPriceId], references: [id], onDelete: Restrict)
  distributorPriceId String?

  @@index([distributorPriceId])
  @@map("shipment_sku")
}
