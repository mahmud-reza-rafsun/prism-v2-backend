model DistributionPoints {
    id String @id @default(uuid())

    name String
    code String? @unique

    distributionId String

    address String?
    contact String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    distributionHouse DistributionHouse @relation(fields: [distributionId], references: [id])

    routes      Routes[]
    outlet      OutletName[]
    salesPlans  SalesPlan[]
    users       User[]
    territory   Territory?   @relation(fields: [territoryId], references: [id])
    territoryId String?

    @@map("distribution_points")
}
