model NewShipment {
  id               String @id @default(uuid())
  sttSkuId         String
  sttSku           SttSku @relation(fields: [sttSkuId], references: [id], onDelete: Restrict)
  onHandStock      Float  @default(0.00)
  ShipmentQuantity Float  @default(0.00)

  @@index([sttSkuId])
  @@map("new_shipment")
}
