model RouteWiseStt {
  id             String       @id @default(uuid())
  region         String
  area           String
  territory      String
  house          String
  point          String
  route          Int          @default(0)
  totalStt       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  businessDateId String
  sttSkuId       String
  businessDate   BusinessDate @relation(fields: [businessDateId], references: [id], onDelete: Restrict)

  @@map("route_wise_stt")
}
