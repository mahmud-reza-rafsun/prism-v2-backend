model Territory {
  id                  String               @id @default(uuid())
  name                String
  code                String?              @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  distributionHouseId String
  areaId              String
  area                Area                 @relation(fields: [areaId], references: [id], onDelete: Restrict)
  distributionPoints  DistributionPoints[]
  byOutletStt         ByOutletStt[]
  users               User[]

  @@unique([name, distributionHouseId])
  @@index([distributionHouseId, areaId])
  @@map("territory")
}
