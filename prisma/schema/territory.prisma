model Territory {
  id                  String               @id @default(uuid())
  name                String
  code                String?              @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  distributionHouseId String
  distributionPoints  DistributionPoints[]
  users               User[]

  @@unique([name, distributionHouseId])
  @@map("territory")
}
