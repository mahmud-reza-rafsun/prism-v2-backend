model SalesSummaryStatement {
  id                  String         @id @default(uuid())
  noOfOutlets         Int            @default(0)
  noOfMemos           Int            @default(0)
  totalVolume         Int            @default(0)
  totalValue          Decimal        @default(0.0) @db.Decimal(10, 2)
  percentOfVolume     Float          @default(0)
  percentOfValue      Float          @default(0)
  discountAmount      Decimal        @default(0.0) @db.Decimal(10, 2)
  unnotiReimbursement Decimal        @default(0.0) @db.Decimal(10, 2)
  netValue            Decimal        @default(0.0) @db.Decimal(10, 2)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  businessDateId      String
  sectionId           String
  sttSkuId            String
  businessDate        BusinessDate   @relation(fields: [businessDateId], references: [id], onDelete: Restrict)
  section             Section        @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  retailerPrice       RetailerPrice? @relation(fields: [retailerPriceId], references: [id])
  retailerPriceId     String

  @@index([businessDateId, sectionId, sttSkuId, retailerPriceId])
  @@map("sales_summary_statement")
}
