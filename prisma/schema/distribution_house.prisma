model DistributionHouse {
  id        String   @id @default(uuid())
  name      String
  code      String?  @unique
  areaId    String
  address   String?
  contact   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, areaId])
  @@map("distribution_houses")
}
