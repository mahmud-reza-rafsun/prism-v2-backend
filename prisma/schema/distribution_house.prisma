model DistributionHouse {
  id        String   @id @default(uuid())
  name      String
  code      String?  @unique
  areaId    String
  address   String?
  contact   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipmentOrders     ShipmentOrder[]
  distributionPoints DistributionPoints[]
  byOutletStts       ByOutletStt[]
  users              User[]
  igt                AddNewIgt[]
  distributorPrices  DistributorPrice[]

  area Area @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@unique([name, areaId])
  @@index([areaId])
  @@map("distribution_house")
}
