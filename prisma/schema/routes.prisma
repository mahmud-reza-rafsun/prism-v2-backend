model Routes {
  id                   String             @id @default(uuid())
  routeNumber          Int                @default(0)
  distributionPointsId String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  distributionPoints   DistributionPoints @relation(fields: [distributionPointsId], references: [id], onDelete: Restrict)
  outlets              OutletName[]       @relation("OutletNameToRoutes")
  finalSubmits         FinalSubmit[]

  @@map("routes")
}
