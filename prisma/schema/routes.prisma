model Routes {
    id                   String             @id @default(uuid())
    routeNumber          Int                @default(0)
    distributionPointsId String
    distributionPoints   DistributionPoints @relation(fields: [distributionPointsId], references: [id])

    outlets OutletName[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("routes")
}
