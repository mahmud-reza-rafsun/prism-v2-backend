model SkuName {
    id           String @id @default(uuid())
    outletNameId String @unique

    // B&H Series
    bhSf20hl         Int @default(0)
    bhSf12hl         Int @default(0)
    bhBgLep20hl      Int @default(0)
    bhBgPug12hl      Int @default(0)
    bhSwLep20hl      Int @default(0)
    bhSw12hl         Int @default(0)
    bhPt20hl         Int @default(0)
    bhBreeze20hlLepp Int @default(0)

    // Alchemy Series
    alchemyMix1 Int @default(0)
    alchemy7mg  Int @default(0)

    // JPGL & John Player Series
    jpgl20hl     Int @default(0)
    jpglFfWp20hl Int @default(0)
    jpgl12hl     Int @default(0)
    jpglFfWp12hl Int @default(0)
    jpSp20hl     Int @default(0)
    jpSw20hl     Int @default(0)
    jpSwWp20hl   Int @default(0)

    // CAP & Lucky Strike Series
    cap20hl      Int @default(0)
    lsCc20hlPug  Int @default(0)
    lsCc10hl     Int @default(0)
    lsOg20hlPug  Int @default(0)
    lsBc20hlPug  Int @default(0)
    lsBc10hl     Int @default(0)
    lsFt20hlPug  Int @default(0)
    lsFt10hl     Int @default(0)
    lsRed20hlPug Int @default(0)

    // Luckies Series
    luckiesMint20hl   Int @default(0)
    luckiesFf20hl     Int @default(0)
    luckiesCitrus20hl Int @default(0)

    // SRF & Star Series
    srf20hl      Int @default(0)
    srf10hl      Int @default(0)
    starFfWp10hl Int @default(0)

    // Pilot (PL) Series
    pl20hl   Int @default(0)
    plWp20hl Int @default(0)

    // Derby Series
    derbyWp20hl    Int @default(0)
    derby20hl      Int @default(0)
    derby10hl      Int @default(0)
    derbyWp10hl    Int @default(0)
    derbyStyle20hl Int @default(0)
    dbStyleWp20hl  Int @default(0)
    derbyStyle10hl Int @default(0)
    dbStyleWp10hl  Int @default(0)
    dbSelect20hl   Int @default(0)
    dbSelect10hl   Int @default(0)
    dbDeluxe20hl   Int @default(0)
    dbDeluxe10hl   Int @default(0)
    derbyPlus20hl  Int @default(0)
    derbyPlus10hl  Int @default(0)

    // Hollywood & Royals (RL) Series
    hlGlWp20hl    Int @default(0)
    hwGl20hl      Int @default(0)
    rlGl20hl      Int @default(0)
    rlGl10hl      Int @default(0)
    rlNx20hl      Int @default(0)
    rlNx10hl      Int @default(0)
    rlLs10hl      Int @default(0)
    royalsRed10hl Int @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    Shipments             Shipment[]
    OwnPointDistributions OwnPointDistribution[]
    StockManagementReport StockManagement[]
    SalesSummaryStatement SalesSummaryStatement[]
    DsrrsReports          DsrrsReport[]
    RouteWiseSttReport    RouteWiseStt[]
    RouteWiseMemoReport   RouteWiseMemo[]
    ByOutletStt           ByOutletStt[]
    ShipmentOrder         ShipmentOrder[]
    salesPlans            SalesPlan[]
    retailers             Retailer[]

    @@map("sku_name")
}
