model SkuName {
    id     String @id @default(uuid())
    name   String @unique
    code   String @unique
    series String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    newShipments          NewShipment[]
    ownPointDistributions OwnPointDistribution[]
    stockManagement       StockManagement[]
    salesSummaryStatement SalesSummaryStatement[]
    dsrrsReports          DsrrsReport[]
    routeWiseStt          RouteWiseStt[]
    routeWiseMemo         RouteWiseMemo[]
    byOutletStt           ByOutletStt[]
    shipmentOrder         ShipmentOrder[]
    salesPlans            SalesPlan[]
    outlets               OutletName[]

    @@map("product")
}
