model FinalSubmit {
  id             String            @id @default(uuid())
  date           DateTime          @db.Date
  point          String
  sttNumber      String            @unique
  value          Decimal           @default(0.0) @db.Decimal(15, 2)
  status         FinalSubmitStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  businessDateId String
  businessDate   BusinessDate      @relation(fields: [businessDateId], references: [id])
  sectionId      String
  routeSectionId RouteSection[]

  distributionPointId String
  distributionPoint   DistributionPoints @relation(fields: [distributionPointId], references: [id])

  @@index([businessDateId, distributionPointId, sectionId])
  @@map("final_submit")
}
