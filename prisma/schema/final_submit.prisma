model FinalSubmit {
  id             String            @id @default(uuid())
  date           DateTime          @db.Date
  point          String
  sttNumber      String            @unique
  value          Decimal           @default(0.0) @db.Decimal(15, 2)
  status         FinalSubmitStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  businessDateId String
  sectionId      String
  businessDate   BusinessDate      @relation(fields: [businessDateId], references: [id])
  section        Section           @relation(fields: [sectionId], references: [id])

  @@map("final_submits")
}
