model FinalSubmit {
    id String @id @default(uuid())

    // Date & Logistics
    date  DateTime @db.Date
    point String

    // Transaction Info
    sttNumber String  @unique
    value     Decimal @default(0.0) @db.Decimal(15, 2)

    // Status & Actions
    status         FinalSubmitStatus @default(PENDING)
    businessDateId String
    businessDate   BusinessDate      @relation(fields: [businessDateId], references: [id])
    sectionId      String
    section        Section           @relation(fields: [sectionId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("final_submits")
}
