model FinalSubmit {
  id             String            @id @default(uuid())
  date           DateTime          @db.Date
  point          String
  sttNumber      String            @unique
  value          Decimal           @default(0.0) @db.Decimal(15, 2)
  status         FinalSubmitStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  businessDateId String
  businessDate   BusinessDate      @relation(fields: [businessDateId], references: [id])
  sectionId      String
  section        Section           @relation(fields: [sectionId], references: [id])

  routeSectionId String
  route          RouteSection @relation(fields: [routeSectionId], references: [id])

  distributionPointId String
  distributionPoint   DistributionPoints @relation(fields: [distributionPointId], references: [id])

  @@index([businessDateId], name: "idx_final_submit_business_date_id")
  @@index([sectionId], name: "idx_final_submit_section_id")
  @@index([routeSectionId], name: "idx_final_submit_route_id")
  @@index([distributionPointId], name: "idx_final_submit_distribution_point_id")
  @@map("final_submit")
}
