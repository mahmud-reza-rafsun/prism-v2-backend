model ShipmentOrder {
    id String @id @default(uuid())

    skuNameId String
    skuName   SkuName @relation(fields: [skuNameId], references: [id])

    quantity   Int      @default(0)
    targetDate DateTime @db.Date

    distributionHouseId String
    distributionHouse   DistributionHouse @relation(fields: [distributionHouseId], references: [id])
    isFinalized         Boolean           @default(false)
    finalizedAt         DateTime?
    unlockRequested     Boolean           @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([skuNameId, targetDate, distributionHouseId])
    @@index([skuNameId])
    @@index([distributionHouseId])
    @@map("shipment_orders")
}
