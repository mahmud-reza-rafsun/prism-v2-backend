model ShipmentOrder {
  id                  String             @id @default(uuid())
  quantity            Float              @default(0.00)
  targetDate          DateTime           @db.Date
  isFinalized         Boolean            @default(true)
  unlockRequested     Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  distributionHouseId String
  distributionHouse   DistributionHouse  @relation(fields: [distributionHouseId], references: [id], onDelete: Restrict)
  shipmentSkuId       String
  shipmentSku         ShipmentSku        @relation(fields: [shipmentSkuId], references: [id], onDelete: Restrict)
  distributorPrices   DistributorPrice[]

  @@unique([shipmentSkuId, targetDate, distributionHouseId])
  @@index([shipmentSkuId, distributionHouseId])
  @@map("shipment_orders")
}
