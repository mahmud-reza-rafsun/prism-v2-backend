model StockManagementSku {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?  @unique
  packSize  String?
  brandId   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockManagements StockManagement[]

  @@index([brandId])
  @@map("stock_management_sku")
}
