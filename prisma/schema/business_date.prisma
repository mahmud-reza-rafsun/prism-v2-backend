model BusinessDate {
  id                    String                  @id @default(uuid())
  businessDate          DateTime                @unique
  isClosed              BusinessDateStatus      @default(FALSE)
  date                  DateTime                @default(now())
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  byOutletStt           ByOutletStt[]
  finalSubmit           FinalSubmit[]
  routeWiseMemo         RouteWiseMemo[]
  routeWiseStt          RouteWiseStt[]
  salesSummaryStatement SalesSummaryStatement[]
  stockManagement       StockManagement[]

  @@map("business_date")
}
