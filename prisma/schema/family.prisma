model Family {
  id        String   @id @default(uuid())
  name      String   @unique
  segmentId String
  segment   Segment  @relation(fields: [segmentId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brands    Brand[]
  skus      SttSku[]

  @@index([segmentId])
  @@map("family")
}
